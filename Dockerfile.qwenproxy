FROM mcr.microsoft.com/playwright:v1.60.0-jammy

ARG QWENPROXY_VERSION=v1.5.1

RUN apt-get update \
  && apt-get install -y --no-install-recommends dumb-init git \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN git clone \
  --branch "${QWENPROXY_VERSION}" \
  --depth 1 \
  https://github.com/pedrofariasx/qwenproxy.git . \
  && rm -rf .git \
  && npm ci --omit=dev \
  && npm cache clean --force

RUN mkdir -p /app/data /app/qwen_profiles \
  && chown -R pwuser:pwuser /app

USER pwuser

VOLUME ["/app/data", "/app/qwen_profiles"]

EXPOSE 3000
ENV NODE_ENV=production PORT=3000

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["npx", "tsx", "src/index.ts"]
