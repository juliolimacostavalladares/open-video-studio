{
  "name": "open-video-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "postinstall": "pnpm db:generate",
    "dev": "pnpm --parallel --filter web --filter api dev",
    "build": "pnpm -r --if-present build",
    "infra:start": "docker compose -p open-video-studio-infrastructure -f docker-compose.infrastructure.yml up -d redis minio",
    "infra:stop": "docker compose -p open-video-studio-infrastructure -f docker-compose.infrastructure.yml down -v",
    "lint": "pnpm -r --if-present lint && eslint packages/config/src tests --ext .ts",
    "db:start": "docker compose -p open-video-studio-database -f docker-compose.database.yml up -d postgres",
    "db:stop": "docker compose -p open-video-studio-database -f docker-compose.database.yml down -v",
    "db:generate": "pnpm --filter @repo/database db:generate",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:reset": "pnpm --filter @repo/database db:reset",
    "db:seed": "pnpm --filter @repo/database db:seed",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:e2e": "pnpm build && playwright test",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "eslint": "8.57.1",
    "prisma": "5.22.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.0.8"
  }
}
