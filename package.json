{
  "name": "open-video-studio",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Powered YouTube Video Creator 100% Automatizado",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prepare": "husky",
    "lockfile-lint": "node ./scripts/lockfile-lint.js"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "cross-env": "10.1.0",
    "eslint": "8.57.0",
    "husky": "9.0.11",
    "lint-staged": "17.0.7",
    "lockfile-lint": "5.0.0",
    "prettier": "3.2.5",
    "prettier-plugin-tailwindcss": "0.6.1",
    "turbo": "2.0.4"
  },
  "packageManager": "pnpm@10.32.1",
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ],
    "pnpm-lock.yaml": [
      "pnpm lockfile-lint"
    ]
  }
}
