# Configuração do Banco de Dados
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54329/open_video_studio?schema=public"

# URL do Redis
REDIS_URL="redis://127.0.0.1:6379"

# TTS OmniVoice Studio (porta local padrão: 3900)
OMNIVOICE_BASE_URL="http://127.0.0.1:3900"

# Provedor de IA (opções: qwenproxy, openai, gemini, etc.)
AI_PROVIDER="qwenproxy"
QWENPROXY_BASE_URL="http://127.0.0.1:3001/v1"
QWENPROXY_API_KEY="sk-no-key-required"
QWENPROXY_MODEL="qwen3.7-plus"
QWENPROXY_TIMEOUT_MS="180000"

# Storage Local para Vídeos & Áudios
STORAGE_DRIVER="local"
STORAGE_BASE_PATH="storage"
STORAGE_BUCKET="open-video-studio"
