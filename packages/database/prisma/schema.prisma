datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-musl-openssl-3.0.x"]
}

model Channel {
  id                    String    @id @default(uuid())
  name                  String
  provider              String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  tokenExpiry           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model VoiceProfile {
  id         String   @id @default(uuid())
  name       String
  provider   String
  voiceId    String
  gender     String?
  previewUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  scenes     Scene[]
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  script      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scenes      Scene[]
}

model Scene {
  id             String        @id @default(uuid())
  projectId      String
  index          Int
  text           String
  audioUrl       String?
  videoUrl       String?
  duration       Float?
  voiceProfileId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceProfile   VoiceProfile? @relation(fields: [voiceProfileId], references: [id])

  @@index([projectId, index])
}
