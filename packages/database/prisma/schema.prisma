datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectStatus {
  draft
  scripting
  rendering
  ready_for_review
  approved
  rejected
  error
}

enum SceneStatus {
  draft
  ready
}

enum VoiceProfileStatus {
  active
  archived
}

enum AssetKind {
  image
  video
  audio
}

enum AssetSource {
  upload
  generated
  external
}

enum AssetStatus {
  ready
  missing
}

enum RenderJobStatus {
  queued
  running
  succeeded
  failed
}

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String?
  theme          String?
  tone           String?
  targetDuration Int?
  rawScript      String?
  status         ProjectStatus @default(draft)
  voiceProfileId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  voiceProfile   VoiceProfile? @relation("ProjectVoiceProfile", fields: [voiceProfileId], references: [id], onDelete: SetNull)
  scenes         Scene[]
  renderJobs     RenderJob[]
  assets         Asset[]
  tags           String[]      @default([])
  approvalLogs   ApprovalLog[]
}

model Scene {
  id             String        @id @default(cuid())
  projectId      String
  orderIndex     Int
  title          String
  script         String
  keywords       String[]
  status         SceneStatus   @default(draft)
  assetId        String?
  audioPath      String?
  audioMimeType  String?
  audioDurationSeconds Float?
  audioContentHash String?
  audioGeneratedAt DateTime?
  voiceProfileId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  asset          Asset?        @relation(fields: [assetId], references: [id], onDelete: SetNull)
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  voiceProfile   VoiceProfile? @relation(fields: [voiceProfileId], references: [id], onDelete: SetNull)

  @@unique([projectId, orderIndex])
}

model VoiceProfile {
  id                    String             @id @default(cuid())
  name                  String
  provider              String
  samplePath            String
  sampleMimeType        String
  sampleDurationSeconds Float
  status                VoiceProfileStatus @default(active)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  projects              Project[]          @relation("ProjectVoiceProfile")
  scenes                Scene[]
}

model Asset {
  id        String      @id @default(cuid())
  projectId String
  kind      AssetKind
  source    AssetSource @default(upload)
  path      String
  status    AssetStatus @default(ready)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes    Scene[]
}

model RenderJob {
  id           String          @id @default(cuid())
  projectId    String
  status       RenderJobStatus @default(queued)
  outputPath   String?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ApprovalLog {
  id           String   @id @default(cuid())
  projectId    String
  approvedAt   DateTime @default(now())
  approvedBy   String
  videoVersion String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}
